{
	"name": "gpuix-fractalsvelte-ui",
	"version": "0.1.0",
	"description": "Component library for Svelte on GPUI via gpuix-svelte)",
	"type": "module",
	"license": "MIT",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./theme": "./src/theme/index.ts",
		"./*": "./src/components/*"
	},
	"files": [
		"src",
		"docs",
		"styles",
		"static"
	],
	"scripts": {
		"gallery": "FRACTALSTYLER_STYLES=./styles gpuix-fractalsvelte gallery/app.ts",
		"sovereign": "FRACTALSTYLER_STYLES=./styles gpuix-fractalsvelte sovereign/app.ts",
		"test": "FRACTALSTYLER_STYLES=./styles bun scripts/test-all.ts",
		"test:one": "gpuix-fractalsvelte",
		"typecheck": "tsc --noEmit && svelte-check --diagnostic-sources js,svelte --fail-on-warnings",
		"docs": "bun scripts/docs.ts",
		"gallery:web": "bun scripts/web.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"gpuix-fractalsvelte": "file:../gpuix-fractalsvelte",
		"svelte": "file:../gpuix-fractalsvelte/vendor/svelte-5.57.2-694f791.tgz",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"sass": "^1.106.1"
	},
	"overrides": {
		"svelte": "file:../gpuix-fractalsvelte/vendor/svelte-5.57.2-694f791.tgz"
	}
}
